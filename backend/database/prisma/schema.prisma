generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  MANAGER
  BRAND
  AUDIENCE
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  roles         Role[]   @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  creator       CreatorProfile?
  memberships   OrganizationMember[]
}

model CreatorProfile {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @unique @db.Uuid
  user          User               @relation(fields: [userId], references: [id])
  slug          String             @unique
  displayName   String
  bio           String?
  countryCode   String             @default("KE") @db.Char(2)
  languages     String[]           @default([])
  categories    String[]           @default([])
  verification  VerificationStatus @default(PENDING)
  socialAccounts SocialAccount[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([countryCode, verification])
}

model SocialAccount {
  id                String         @id @default(uuid()) @db.Uuid
  creatorId         String         @db.Uuid
  creator           CreatorProfile @relation(fields: [creatorId], references: [id])
  platform          String
  handle            String
  providerAccountId String?
  ownershipVerifiedAt DateTime?
  metrics           SocialMetricSnapshot[]

  @@unique([platform, handle])
  @@unique([platform, providerAccountId])
  @@index([creatorId])
}

// Only trusted integrations may write snapshots. Missing metrics remain null.
model SocialMetricSnapshot {
  id              String        @id @default(uuid()) @db.Uuid
  socialAccountId String        @db.Uuid
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  source          String
  followers       BigInt?
  engagementRate  Decimal?      @db.Decimal(9, 6)
  fetchedAt       DateTime      @default(now())

  @@index([socialAccountId, fetchedAt])
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  countryCode  String             @default("KE") @db.Char(2)
  verification VerificationStatus @default(PENDING)
  members      OrganizationMember[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model OrganizationMember {
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId])
}
